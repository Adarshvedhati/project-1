# Base URL for the Django REST Framework API.
# Local development (Vite dev server on :5173 -> Django on :8000):
VITE_API_BASE_URL=http://localhost:8000/api/v1
# In production leave this unset: Django serves the SPA and the API on the same origin ("/api/v1").

# Only for static hosting under a sub-path (e.g. GitHub Pages). Default is "/".
# VITE_BASE=/project-1/
