# Copy to .env and edit. Used by docker-compose.yml (and as a reference for any host).

# --- Django -------------------------------------------------------------------
# REQUIRED in production: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Comma separated hostnames you serve the site on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with scheme) if you use the Django admin / forms over HTTPS on a custom domain.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set true once the site is behind HTTPS (redirects, secure cookies, HSTS).
DJANGO_SECURE_SSL=false

# --- Database -----------------------------------------------------------------
# docker-compose supplies Postgres automatically. Elsewhere set e.g.
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
# (unset = SQLite file, fine for demos only)
POSTGRES_PASSWORD=meridian

# --- First administrator (created on startup if it does not exist) ------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# --- Demo content -------------------------------------------------------------
# SEED_DEMO_DATA=true loads the sample journals/articles/books/case studies.
# SEED_DEMO_USERS=true ALSO creates demo accounts with a publicly known password
# (editor@meridian.test ...). Never enable it on a real public deployment.
SEED_DEMO_DATA=true
SEED_DEMO_USERS=false
